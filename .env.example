# fal.ai API key — get one at https://fal.ai/dashboard/keys
# Used by scripts/polish-deck.py for gpt-image-2 generation.
FAL_KEY=

# ── Monitoring (opencraft-centralized / centralize-apps) ────────────────────
# After a document is rendered, scripts/monitor.ts uploads it to S3 and writes
# telemetry to Supabase so the dashboard can show the document history.
# Leave SUPABASE_* unset to disable reporting entirely (rendering still works).

# Supabase project "centralize-apps" — the SERVICE ROLE key (server-side only,
# bypasses RLS). Never commit it; never expose it to a browser.
SUPABASE_URL=https://wdzmuniyqqyngzckeoph.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# AWS S3 — where the rendered document file is uploaded.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=opencraft-video
AWS_S3_REGION=ap-southeast-1

# Optional overrides
# MONITOR_AGENT_SLUG=document-agent     # registry slug in the agents table
# MONITOR_S3_PREFIX=document-agent       # S3 key prefix: <prefix>/<type>/<file>
